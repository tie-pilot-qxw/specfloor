@@ -0,0 +1,47 @@
+# Added relative to sgl-project/sglang@702de2631 for DSpark prefix-attention drafter serving (specfloor, serving/sglang).
+"""Combine the fixed token projection and the per-slot state projection."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _combine_input_projection(
+    Tokens,
+    Embedding,
+    State,
+    Out,
+    ROWS: tl.constexpr,
+    RANK: tl.constexpr,
+    PREDECESSORS: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    cols = tl.arange(0, BLOCK)
+    token = tl.load(Tokens + row)
+    embed = tl.load(Embedding + token * RANK + cols, cols < RANK, 0)
+    state = tl.load(State + (row // PREDECESSORS) * RANK + cols, cols < RANK, 0)
+    # Both partial projections stay FP32 until after the addition. Rounding each
+    # partial to BF16 first would introduce an extra rounding absent from in_proj.
+    tl.store(Out + row * RANK + cols, embed + state, cols < RANK)
+
+
+def combine_input_projection(token_ids, embedding, state, predecessors, dtype):
+    token_ids = token_ids.reshape(-1).contiguous()
+    rows = token_ids.numel()
+    rank = state.shape[-1]
+    out = torch.empty((rows, rank), device=state.device, dtype=dtype)
+    if rows:
+        _combine_input_projection[(rows,)](
+            token_ids,
+            embedding,
+            state,
+            out,
+            rows,
+            rank,
+            predecessors,
+            triton.next_power_of_2(rank),
+            num_warps=4,
+        )
+    return out
