+class DFlashBlockSelfAttention(nn.Module):
+    """The within-block half of a split DFlash/DSpark attention: own projections, own
+    softmax, no KV cache.
+
+    Today one k_proj/v_proj pair projects two distributions that have nothing to do with
+    each other -- the target's hidden states and the drafter's own slot states -- and
+    both compete for a single softmax.  The split gives each half its own; this module
+    takes the within-block half, and the main attention keeps the context half and stops
+    seeing the draft tokens as keys.
+
+    IT HAS NO CACHE, which is why it needs no attention backend and no paged anything:
+    its keys and values are the K tokens of the block currently being drafted,
+    recomputed every round.  Slot 0 carries the real anchor token and is an ordinary
+    member of the block.
+
+    POSITION IS A LEARNED [heads, K, K] TABLE, NOT RoPE.  At head_dim 128 and
+    rope_theta 1e6 only 11-16 of the 64 frequency pairs resolve distances 1..K-1 at all,
+    so RoPE would spend most of its bandwidth on a scale this module never sees; a table
+    also separates slot 0->1 from slot 5->6, which are the same distance but not the
+    same relation.  At K=7 it costs heads*49 numbers per layer.
+    """
+
+    def __init__(
+        self,
+        *,
+        hidden_size: int,
+        block_size: int,
+        num_heads: int,
+        head_dim: int,
+        rms_norm_eps: float,
+        attention_bias: bool,
+        causal: bool,
+    ) -> None:
+        super().__init__()
+        self.block_size = int(block_size)
+        self.num_heads = int(num_heads)
+        self.head_dim = int(head_dim)
+        self.causal = bool(causal)
+        self.scaling = self.head_dim**-0.5
+        inner = self.num_heads * self.head_dim
+        # MHA, not GQA: grouped KV exists to shrink a KV CACHE and this module has none.
+        self.q_proj = nn.Linear(hidden_size, inner, bias=attention_bias)
+        self.k_proj = nn.Linear(hidden_size, inner, bias=attention_bias)
+        self.v_proj = nn.Linear(hidden_size, inner, bias=attention_bias)
+        self.o_proj = nn.Linear(inner, hidden_size, bias=attention_bias)
+        self.q_norm = RMSNorm(self.head_dim, eps=rms_norm_eps)
+        self.k_norm = RMSNorm(self.head_dim, eps=rms_norm_eps)
+        self.pair_bias = nn.Parameter(
+            torch.zeros(self.num_heads, self.block_size, self.block_size)
+        )
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        """[tokens, hidden] -> [tokens, hidden], block-major with slot 0 first."""
+        tokens, hidden_size = hidden_states.shape
+        block = self.block_size
+        if tokens % block:
+            raise ValueError(
+                f"DFlashBlockSelfAttention needs whole blocks: {tokens} tokens is not a "
+                f"multiple of block_size {block}. Slot identity comes from the position "
+                f"within the block, so a ragged tail would attend across block edges."
+            )
+        num_blocks = tokens // block
+        x = hidden_states.view(num_blocks, block, hidden_size)
+        shape = (num_blocks, block, self.num_heads, self.head_dim)
+        q = self.q_norm(self.q_proj(x).view(shape)).transpose(1, 2)
+        k = self.k_norm(self.k_proj(x).view(shape)).transpose(1, 2)
+        v = self.v_proj(x).view(shape).transpose(1, 2)
+        # K x K is tiny (7x7): an explicit softmax beats a kernel launch, and it is the
+        # only way to add an arbitrary learned bias without a score_mod.
+        scores = (q @ k.transpose(-1, -2)) * self.scaling + self.pair_bias.unsqueeze(0)
