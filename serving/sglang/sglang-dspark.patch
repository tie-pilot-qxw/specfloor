@@ -0,0 +1,239 @@
+# Added relative to sgl-project/sglang@702de2631 for DSpark prefix-attention drafter serving (specfloor, serving/sglang).
+"""Fused DFlash/DSpark short-conv inference kernels.
+
+``short_conv_decode`` is the small-batch path: each CTA owns one channel group
+and two tokens, reduces the full hidden dimension, then applies the block-causal
+convolution. It retains the projection's low-precision output rounding. Larger
+batches use the ordinary GEMM path. The earlier kernel below is retained for A/B
+comparisons via SGLANG_DFLASH_CONV_KERNEL=1.
+
+Background for the earlier grouped kernel:
+
+THE SHAPE IS THE PROBLEM.  The gate is `corr: Linear(hidden -> taps*num_groups)`, which
+at bs=1 is a [8, 2560] x [2560, 320] matmul.  cuBLAS tiles it 8x64 over M and N, which
+yields 5 CTAs on a 132-SM H100 and a 160-step serial reduction over K: measured 5.94 us
+moving 1.64 MB, i.e. 276 GB/s against HBM3's ~3.4 TB/s.  It is latency-bound on an idle
+machine, not bandwidth-bound.  The elementwise conv that consumes the gate is a second
+kernel costing 1.39 us -- the per-kernel floor inside a CUDA graph.  Twenty insertion
+points x two kernels = 146.6 us per round, more than the whole order-1 head saves against
+the vanilla markov head it replaced.
+
+WHY NOT SPLIT-K, THE USUAL ANSWER FOR M=8.  Splitting the reduction does fix the
+occupancy, but the epilogue cannot ride along: the conv needs the COMPLETE gate before it
+can scale anything, so a split-K gate GEMM still needs a second kernel to apply it, and
+the 1.4 us floor survives.
+
+WHY THIS OPERATOR DOES NOT NEED SPLIT-K.  The gate is grouped.  `corr` emits one value
+per (tap, group) and the conv broadcasts group g over channels [g*group_size,
+(g+1)*group_size) -- so a program that owns a few groups owns BOTH the weight columns
+that produce their gate values AND the exact channels those values scale.  Nothing
+crosses program boundaries, so the reduction and the epilogue live in one kernel and the
+grid is num_groups (160) rather than 5.
+
+  traffic: weight 2*group*K bytes per program, disjoint across programs -> 1.64 MB once
+           x is re-read by every program but is 40 KB and stays in L2
+  order:   each program reduces its own K in a fixed sequence; no atomics, no split-K,
+           so the result is bitwise reproducible run to run.  That matters because a
+           drifting reduction order would move accept length, and accept length is the
+           number this whole line of work is trying to protect.
+
+Slot 0 of each block has no predecessor, so its tap-1 term is masked rather than read
+out of the previous block.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit(do_not_specialize=["T"])
+def _short_conv_decode_kernel(
+    X,
+    W,
+    Base,
+    Out,
+    T,
+    D: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+    GROUPS: tl.constexpr,
+    GROUP_SIZE: tl.constexpr,
+    TAPS: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    # Two tokens per CTA keeps the full K reduction in registers without the
+    # old kernel's serial K loop. The token tiles supply enough independent CTAs
+    # to hide weight-load latency at small batch sizes.
+    group = tl.program_id(0)
+    rows = tl.program_id(1) * 2 + tl.arange(0, 2)
+    k = tl.arange(0, BLOCK_K)
+    x = tl.load(
+        X + rows[:, None] * D + k[None, :], (rows[:, None] < T) & (k[None, :] < D), 0
+    ).to(tl.float32)
+    w0 = tl.load(W + group * D + k, k < D, 0).to(tl.float32)
+    # F.linear materializes a low-precision gate. Preserve that rounding before
+    # the fp32 convolution epilogue (the legacy fused kernel omitted it).
+    c0 = tl.sum(x * w0[None, :], 1).to(X.dtype.element_ty).to(tl.float32)
+    ch = group * GROUP_SIZE + tl.arange(0, GROUP_SIZE)
+    b0 = tl.load(Base + ch).to(tl.float32)
+    x0 = tl.load(X + rows[:, None] * D + ch[None, :], rows[:, None] < T, 0).to(
+        tl.float32
+    )
+    y = (b0[None, :] + c0[:, None]) * x0
+    if TAPS == 2:
+        w1 = tl.load(W + (GROUPS + group) * D + k, k < D, 0).to(tl.float32)
+        c1 = tl.sum(x * w1[None, :], 1).to(X.dtype.element_ty).to(tl.float32)
+        b1 = tl.load(Base + D + ch).to(tl.float32)
+        has_prev = rows % BLOCK_SIZE > 0
+        x1 = tl.load(
+            X + (rows[:, None] - 1) * D + ch[None, :],
+            ((rows < T) & has_prev)[:, None],
+            0,
+        ).to(tl.float32)
+        y += (b1[None, :] + c1[:, None]) * x1
+    tl.store(Out + rows[:, None] * D + ch[None, :], y, rows[:, None] < T)
+
+
+def short_conv_decode(hidden_states, corr_weight, k_base, block_size, group_size):
+    """Small decode batches; one launch for the projection and block-causal conv.
+
+    Larger batches stay on the GEMM path. T is not specialized, so one warmup
+    covers every supported batch and graph padding size, including odd T.
+    """
+    tokens, hidden = hidden_states.shape
+    taps = k_base.shape[0]
+    assert taps in (1, 2) and hidden % group_size == 0
+    assert group_size > 0 and group_size & (group_size - 1) == 0
+    assert (
+        hidden_states.is_contiguous()
+        and corr_weight.is_contiguous()
+        and k_base.is_contiguous()
+    )
+    out = torch.empty_like(hidden_states)
+    if tokens:
+        _short_conv_decode_kernel[(hidden // group_size, triton.cdiv(tokens, 2))](
+            hidden_states,
+            corr_weight,
+            k_base,
+            out,
+            tokens,
+            hidden,
+            block_size,
+            hidden // group_size,
+            group_size,
+            taps,
+            triton.next_power_of_2(hidden),
+            num_warps=4,
+            enable_fp_fusion=False,
+        )
+    return out
+
+
+@triton.jit
+def _short_conv_kernel(
+    x_ptr,  # [T, D] bf16/fp16 -- T = blocks * block_size
+    w_ptr,  # [taps * num_groups, D] gate projection, row = tap*num_groups + g
+    kbase_ptr,  # [taps, D]
+    out_ptr,  # [T, D]
+    T,
+    D: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,  # slots per draft block
+    NUM_GROUPS: tl.constexpr,
+    GROUP_SIZE: tl.constexpr,
+    TAPS: tl.constexpr,
+    BLOCK_T: tl.constexpr,  # >= T, power of two
+    BLOCK_K: tl.constexpr,
+):
+    # One program per group. T is a VECTOR dimension, not a loop: a first version looped
+    # over rows, re-read this group's weight columns once per row (8x the intended
+    # traffic) and reduced to a scalar with tl.sum on every K step -- 80 block reductions
+    # per program, and 4x SLOWER than the two-kernel path it was meant to replace.
+    g = tl.program_id(0)
+    rows = tl.arange(0, BLOCK_T)
+    rmask = rows < T
+
+    acc0 = tl.zeros([BLOCK_T], dtype=tl.float32)
+    acc1 = tl.zeros([BLOCK_T], dtype=tl.float32)
+    for k0 in range(0, D, BLOCK_K):
+        off = k0 + tl.arange(0, BLOCK_K)
+        kmask = off < D
+        xv = tl.load(
+            x_ptr + rows[:, None] * D + off[None, :],
+            mask=rmask[:, None] & kmask[None, :], other=0.0,
+        ).to(tl.float32)
+        w0 = tl.load(w_ptr + g * D + off, mask=kmask, other=0.0).to(tl.float32)
+        acc0 += tl.sum(xv * w0[None, :], axis=1)
+        if TAPS > 1:
+            w1 = tl.load(
+                w_ptr + (NUM_GROUPS + g) * D + off, mask=kmask, other=0.0
+            ).to(tl.float32)
+            acc1 += tl.sum(xv * w1[None, :], axis=1)
+
+    # Epilogue, in the same program: this group's gate values scale exactly the channels
+    # this group owns, so nothing crosses program boundaries and no second kernel is
+    # needed to apply them.
+    ch = g * GROUP_SIZE + tl.arange(0, GROUP_SIZE)
+    k0b = tl.load(kbase_ptr + ch).to(tl.float32)[None, :]
+    xt = tl.load(
+        x_ptr + rows[:, None] * D + ch[None, :], mask=rmask[:, None], other=0.0
+    ).to(tl.float32)
+    res = (k0b + acc0[:, None]) * xt
+    if TAPS > 1:
+        k1b = tl.load(kbase_ptr + D + ch).to(tl.float32)[None, :]
+        prev = rows - 1
+        # Slot 0 of each block has no predecessor inside its block.
+        has_prev = (rows % BLOCK_SIZE) > 0
+        xp = tl.load(
+            x_ptr + prev[:, None] * D + ch[None, :],
+            mask=(rmask & has_prev)[:, None], other=0.0,
+        ).to(tl.float32)
+        res += tl.where(has_prev[:, None], (k1b + acc1[:, None]) * xp, 0.0)
+    tl.store(
+        out_ptr + rows[:, None] * D + ch[None, :],
+        res.to(out_ptr.dtype.element_ty), mask=rmask[:, None],
+    )
+
+
+# A FIXED ladder of specializations, all warmed before capture.
+#
+# BLOCK_T used to be derived from T, so the warmup forward (a long prefill) compiled one
+# variant and the decode capture asked for another -- and a triton kernel launched for
+# the first time INSIDE a CUDA graph capture must load its module there, which surfaces
+# as "Triton Error [CUDA]: out of memory" and takes the server down. A closed ladder
+# means every shape a capture can ask for was already compiled; T = bs * block_size, so
+# this covers batches up to 32 at block 8 and the caller falls back beyond that.
+BLOCK_T_LADDER = (8, 16, 32, 64, 128, 256)
+MAX_T = BLOCK_T_LADDER[-1]
+
+
+def _block_t(T):
+    for b in BLOCK_T_LADDER:
+        if T <= b:
+            return b
+    return None
+
+
+def short_conv_fused(hidden_states, corr_weight, k_base, block_size, num_groups,
+                     group_size, taps):
+    """hidden_states [T, D] -> [T, D], T <= MAX_T. See the module docstring."""
+    assert hidden_states.is_contiguous() and corr_weight.is_contiguous()
+    T, D = hidden_states.shape
+    bt = _block_t(T)
+    assert bt is not None, f"T={T} exceeds the compiled ladder {BLOCK_T_LADDER}"
+    out = torch.empty_like(hidden_states)
+    _short_conv_kernel[(num_groups,)](
+        hidden_states, corr_weight, k_base, out, T,
+        D=D, BLOCK_SIZE=block_size, NUM_GROUPS=num_groups, GROUP_SIZE=group_size,
+        TAPS=taps, BLOCK_T=bt,
+        # Swept on H100 at the production shape (T=8, D=2560, 160 groups): larger K
+        # steps beat more of them, and num_stages was flat because the loop is only 3
+        # iterations deep. 5.20 us/site against the two-kernel path's 9.02.
+        BLOCK_K=1024, num_warps=2, num_stages=1,
+    )
+    return out
+
+
+def warm_ladder(like, corr_weight, k_base, block_size, num_groups, group_size, taps):
+    """Compile every ladder entry now, outside any CUDA graph capture."""
+    for bt in BLOCK_T_LADDER:
+        short_conv_fused(like.new_zeros(bt, like.shape[-1]), corr_weight, k_base,
+                         block_size, num_groups, group_size, taps)
diff --git a/python/sglang/kernels/ops/speculative/dspark/attn_head.py b/python/sglang/kernels/ops/speculative/dspark/attn_head.py
