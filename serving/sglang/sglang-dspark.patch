index 0000000000..f7f8575ac4
--- /dev/null
+++ b/python/sglang/kernels/ops/speculative/dspark/fused_ctx_kv_write.py
@@ -0,0 +1,108 @@
+# Added relative to sgl-project/sglang@702de2631 for DSpark prefix-attention drafter serving (specfloor, serving/sglang).
+from typing import Optional
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _fused_ctx_kv_norm_write_kernel(
+    kv_ptr,
+    knw_ptr,
+    loc_ptr,
+    commit_lens_ptr,
+    k_cache_ptr,
+    v_cache_ptr,
+    locs_row_width,
+    KV: tl.constexpr,
+    D: tl.constexpr,
+    NH: tl.constexpr,
+    EPS: tl.constexpr,
+    HAS_COMMIT_LENS: tl.constexpr,
+):
+    t = tl.program_id(0).to(tl.int64)
+    if HAS_COMMIT_LENS:
+        row_b = t // locs_row_width
+        col = t - row_b * locs_row_width
+        num_commit = tl.load(commit_lens_ptr + row_b).to(tl.int64)
+        if col >= num_commit:
+            return
+    loc = tl.load(loc_ptr + t).to(tl.int64)
+    if loc < 0:
+        return
+
+    d_ar = tl.arange(0, D)
+    # One k_norm for the whole head, unlike the per-layer backbone write.
+    knw = tl.load(knw_ptr + d_ar).to(tl.float32)
+    row = kv_ptr + t * (2 * KV)
+    for h in tl.static_range(NH):
+        k = tl.load(row + h * D + d_ar).to(tl.float32)
+        ms = tl.sum(k * k, 0) / D
+        inv = 1.0 / tl.sqrt(ms + EPS)
+        tl.store(k_cache_ptr + loc * KV + h * D + d_ar, (k * inv * knw).to(tl.bfloat16))
+        v = tl.load(row + KV + h * D + d_ar)
+        tl.store(v_cache_ptr + loc * KV + h * D + d_ar, v)
+
+
+def fused_ctx_kv_norm_write(
+    *,
+    kv: torch.Tensor,
+    k_norm_weight: torch.Tensor,
+    locs: torch.Tensor,
+    k_cache: torch.Tensor,
+    v_cache: torch.Tensor,
+    num_heads: int,
+    head_dim: int,
+    eps: float,
+    commit_lens: Optional[torch.Tensor] = None,
+    locs_row_width: Optional[int] = None,
+) -> None:
+    """Write normed K and raw V rows into the AttnHead's own context cache.
+
+    The head's cache is a pool of its own, num_heads wide where a drafter layer's
+    slot is num_key_value_heads wide, so it cannot ride along in the backbone's
+    per-layer write; this is that write's single-layer, no-RoPE twin.  No RoPE
+    because the head applies none -- keys come from target hidden states that
+    already carry position, and the training-side head has no rotary either.
+
+    Rows with loc < 0 are skipped.  When commit_lens is given, locs is the
+    flattened [bs, locs_row_width] verify window and only the first
+    commit_lens[b] columns of each row are written -- the in-kernel replacement
+    for building a boolean mask on the host and steering rejected rows to a
+    dummy slot.
+    """
+    T = kv.shape[0]
+    if T == 0:
+        return
+    has_commit_lens = commit_lens is not None
+    if has_commit_lens != (locs_row_width is not None):
+        raise ValueError(
+            "commit_lens and locs_row_width must be passed together, got "
+            f"commit_lens={'set' if has_commit_lens else None}, "
+            f"locs_row_width={locs_row_width}."
+        )
+    if has_commit_lens:
+        if commit_lens.numel() * locs_row_width != locs.numel():
+            raise ValueError(
+                f"locs must be a flattened [{commit_lens.numel()}, "
+                f"{locs_row_width}] window, got numel={locs.numel()}."
+            )
+        commit_lens_arg = commit_lens.contiguous()
+    else:
+        locs_row_width = 1
+        commit_lens_arg = locs
+    _fused_ctx_kv_norm_write_kernel[(T,)](
+        kv,
+        k_norm_weight,
+        locs.to(torch.int64).contiguous(),
+        commit_lens_arg,
+        k_cache,
+        v_cache,
+        locs_row_width,
+        KV=num_heads * head_dim,
+        D=head_dim,
+        NH=num_heads,
+        EPS=eps,
+        HAS_COMMIT_LENS=has_commit_lens,
+    )
