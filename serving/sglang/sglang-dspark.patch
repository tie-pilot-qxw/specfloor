+    SGLANG_DSPARK_LATTICE_TOPK = EnvInt(-1)
+    SGLANG_DFLASH_ALLOW_BLOCK_SIZE_OVERRIDE = EnvBool(False)
     SGLANG_DSPARK_STACKED_CTX_KV = EnvBool(True)
     SGLANG_DSPARK_EMBED_IN_GRAPH = EnvBool(True)
