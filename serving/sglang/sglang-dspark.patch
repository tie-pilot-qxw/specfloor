@@ -0,0 +1,53 @@
+# Added relative to sgl-project/sglang@702de2631 for DSpark prefix-attention drafter serving (specfloor, serving/sglang).
+"""Standalone kernel checks, runnable under memcheck without FA3/norm JIT probing."""
+
+import pytest
+import torch
+
+from sglang.kernels.ops.speculative.dspark.attn_head import combine_input_projection
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+
+
+@torch.no_grad()
+@pytest.mark.parametrize("predecessors,rank", [(1, 64), (5, 63), (16, 512)])
+def test_gather_broadcast_and_graph(predecessors, rank):
+    torch.manual_seed(15)
+    tokens = torch.randint(31, (6, predecessors, 2), device="cuda")[:, :, 1]
+    table = torch.randn(31, rank, device="cuda")
+    state = torch.randn(6, rank, device="cuda")
+    fn = lambda: combine_input_projection(
+        tokens, table, state, predecessors, torch.bfloat16
+    )
+
+    def reference():
+        return (table[tokens] + state[:, None]).reshape(-1, rank).bfloat16()
+
+    torch.testing.assert_close(fn(), reference(), atol=0, rtol=0)
+    stream = torch.cuda.Stream()
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        for _ in range(3):
+            fn()
+    torch.cuda.current_stream().wait_stream(stream)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        output = fn()
+    tokens.fill_(4)
+    # Cancellation makes an unintended BF16 rounding of either partial visible.
+    table.fill_(1.001)
+    state.fill_(-1)
+    graph.replay()
+    torch.testing.assert_close(output, reference(), atol=0, rtol=0)
+    assert output.abs().min() > 0
+
+
+def test_empty_projection():
+    out = combine_input_projection(
+        torch.empty(0, device="cuda", dtype=torch.long),
+        torch.zeros(31, 64, device="cuda"),
+        torch.empty(0, 64, device="cuda"),
+        1,
+        torch.bfloat16,
+    )
+    assert out.shape == (0, 64) and out.dtype == torch.bfloat16
diff --git a/test/srt/speculative/test_attn_head_parity.py b/test/srt/speculative/test_attn_head_parity.py
new file mode 100644
index 0000000000..2fbe8c53e2
--- /dev/null
+++ b/test/srt/speculative/test_attn_head_parity.py
@@ -0,0 +1,258 @@
+# Added relative to sgl-project/sglang@702de2631 for DSpark prefix-attention drafter serving (specfloor, serving/sglang).
+"""sglang's AttnHead against the module that trained it.
+
+Unlike the other heads in this port, the attention here is NOT a transcription.  Training
+materialises the committed prefix as a dense [b, heads, S, dim] tensor and applies a flex
+mask; serving reads a PAGED cache and merges the single anchor key analytically off the
+kernel's log-sum-exp.  Two different algorithms for one function, so "the names match" and
+"it runs" are both worthless -- only same-weights-same-inputs-same-output is evidence.
+
+The anchor merge is the part most likely to be subtly wrong, so there is a test for its
+two degenerate ends as well: an empty prefix (the answer must be exactly the anchor value)
+and an anchor the query cannot see (the answer must be exactly the prefix attention).
+
+Run: /workspace/sglang-eval-env/bin/python -m pytest <this file> -q
+"""
+import pytest
+import torch
+
+from sglang.srt.models.dspark import AttnHead, AttnHeadContext
+
+VOCAB = 256
+RANK = 64
+HIDDEN = 128
+HEADS = 2
+HEAD_DIM = 32
+MLP_HIDDEN = 96
+EPS = 1e-6
+BS = 3
+PREFIX = 17
+
+cuda_only = pytest.mark.skipif(
+    not torch.cuda.is_available(), reason="paged flash attention needs CUDA"
+)
+
+
+def _pair(gate_mode="state_output", dtype=torch.bfloat16):
+    _m = pytest.importorskip(
+        "deepspec.modeling.dspark.attn_head",
+        reason="the training-side reference lives in the DeepSpec repo, which this project neither vendors nor declares as a dependency. Skipping means this parity check does NOT run here -- the serving module is unverified against the one the weights were trained with.",
+    )
+    TrainHead = _m.AttnHead
+
+    torch.manual_seed(0)
+    embed = torch.nn.Embedding(VOCAB, HIDDEN)
+    train = TrainHead(
+        vocab_size=VOCAB, markov_rank=RANK, hidden_size=HIDDEN, num_heads=HEADS,
+        head_dim=HEAD_DIM, mlp_hidden=MLP_HIDDEN, gate_mode=gate_mode,
+        rms_norm_eps=EPS,
+    )
+    with torch.no_grad():
+        for param in train.parameters():
+            param.normal_(0.0, 0.05)
+        # anchor_type is zero-initialised in training; leaving it would drop the one
+        # parameter that marks the anchor as a different kind of input.
+        train.anchor_type.normal_(0.0, 0.05)
+    serve = AttnHead(
+        vocab_size=VOCAB, markov_rank=RANK, hidden_size=HIDDEN, num_heads=HEADS,
+        head_dim=HEAD_DIM, mlp_hidden=MLP_HIDDEN, gate_mode=gate_mode,
+        rms_norm_eps=EPS,
+    )
+    missing, unexpected = serve.load_state_dict(train.state_dict(), strict=False)
+    assert not unexpected, f"the serving head has no home for {unexpected}"
+    assert not missing, f"the serving head wants weights training never had: {missing}"
+    train.set_embedding_source(embed)
+    serve.set_embedding_source(embed)
+    dev = "cuda"
+    return (
+        train.to(device=dev, dtype=dtype).eval(),
+        serve.to(device=dev, dtype=dtype).eval(),
+        embed.to(device=dev, dtype=dtype),
+    )
+
+
+def _contexts(serve, target_hidden, anchor_ids, prefix_len):
+    """A dense context for training and a paged one for serving, over the same prefix."""
+    dev = target_hidden.device
+    # Page table is deliberately NOT the identity: a bug that ignores it would pass
+    # against contiguous slots and fail in production on the first evicted request.
+    slots = BS * (prefix_len + 4)
+    # The last BS slots are reserved, one anchor per request, and the prefix is drawn
+    # from the rest.  Both properties are load-bearing:
+    #   * UNIQUE per row -- a single shared slot makes the anchor write an advanced-index
+    #     write with duplicate indices, where exactly one value survives.  Every serving
+    #     row then attends to one request's anchor while training gives each row its own,
+    #     so the test compares two different quantities and a real bug rides through.
+    #   * DISJOINT from the prefix -- an anchor slot that also appears in the page table
+    #     overwrites a prefix K/V, silently weakening the comparison it is part of.
+    anchor_slots = torch.arange(slots - BS, slots, device=dev)
+    perm = torch.randperm(slots - BS, device=dev)[: BS * prefix_len].view(BS, prefix_len)
+    # [pages, page_size, heads, dim] with page_size = 1, which is what sglang runs and
+    # what the paged kernel requires.
+    key_cache = torch.zeros(slots, 1, HEADS, HEAD_DIM, device=dev,
+                            dtype=target_hidden.dtype)
+    value_cache = torch.zeros_like(key_cache)
+    with torch.no_grad():
+        k, v = serve.context_kv(target_hidden.reshape(-1, HIDDEN))
+        key_cache[perm.reshape(-1), 0] = k
+        value_cache[perm.reshape(-1), 0] = v
+    # Give the head its own pool and let build_serving_context place the anchor, so the
+    # test exercises the scatter that production uses rather than a hand-built context.
+    serve._key_cache = key_cache
+    serve._value_cache = value_cache
+    anchor_slot = anchor_slots.to(torch.long)
+    assert anchor_slot.unique().numel() == BS, "anchor slots must be distinct per row"
+    assert not bool((perm.reshape(-1, 1) == anchor_slot.view(1, -1)).any()), \
+        "anchor slots must not collide with prefix page-table entries"
+    with torch.no_grad():
+        return serve.build_serving_context(
+            page_table=torch.cat(
+                [perm, torch.zeros(BS, 1, dtype=perm.dtype, device=dev)], dim=1
+            ),
+            prefix_lens=torch.full((BS,), prefix_len, dtype=torch.int32, device=dev),
+            anchor_token_ids=anchor_ids,
+            anchor_cache_loc=anchor_slot,
+        )
+
+
+def _train_context(train, target_hidden, anchor_ids, prefix_len):
+    dev = target_hidden.device
+    return train.build_context(
+        target_hidden=target_hidden,
+        anchor_token_ids=anchor_ids.view(BS, 1),
+        # anchor_positions == prefix_len makes every context column visible, matching
+        # cache_seqlens on the serving side.  The exclusion of the anchor's own hidden
+        # is the caller's job on both sides and is asserted separately, end to end.
+        anchor_positions=torch.full((BS, 1), prefix_len, dtype=torch.long, device=dev),
+        block_keep_mask=torch.ones(BS, 1, dtype=torch.bool, device=dev),
+        block_size=1,
+    )
+
+
+@cuda_only
+@pytest.mark.parametrize("gate_mode", ["state_output", "none"])
+def test_step_bias_matches_training(gate_mode):
+    train, serve, _ = _pair(gate_mode)
+    torch.manual_seed(1)
+    dev = "cuda"
+    target_hidden = torch.randn(BS, PREFIX, HIDDEN, device=dev, dtype=torch.bfloat16)
+    anchor_ids = torch.randint(0, VOCAB, (BS,), device=dev)
+    prev_ids = torch.randint(0, VOCAB, (BS,), device=dev)
+    hidden = torch.randn(BS, HIDDEN, device=dev, dtype=torch.bfloat16)
+
+    with torch.no_grad():
+        expected = train.compute_block_latent(
+            prev_ids.view(BS, 1, 1),
+            hidden.view(BS, 1, 1, HIDDEN),
+            _train_context(train, target_hidden, anchor_ids, PREFIX),
+        ).view(BS, -1).float()
+        actual = serve.compute_step_latent(
+            prev_ids, hidden, _contexts(serve, target_hidden, anchor_ids, PREFIX)
+        ).float()
+
+    # A per-row anchor is 1 key among PREFIX+1, so its whole contribution is small and
+    # a tolerance picked for comfort hides it.  Measured over 12 seeds, both gate modes:
+    #   bf16 parity floor (correct implementation) : <= 4.9e-4
+    #   shared anchor slot across rows (the bug)   : >= 2.9e-3
+    # a 6x window, and the old 3e-2 sat an order of magnitude ABOVE the bug -- the test
+    # passed with every row reading one request's anchor.  1.2e-3 is the geometric mean
+    # of the two, so it clears the noise floor by 2.4x and trips on the bug by 2.4x.
+    TOL = 1.2e-3
+    scale = max(1.0, expected.abs().max().item())
+    err = (expected - actual).abs().max().item()
+    assert err <= TOL * scale, f"{gate_mode}: max|train - serve| = {err:.3e} on {scale:.3e}"
+
+    # And prove the comparison can SEE the anchor, rather than trusting that it does.
+    # Without this the assertion above is satisfiable by an implementation that ignores
+    # the per-row anchor entirely, which is exactly what the previous fixture did.
+    shared = serve.compute_step_latent(
+        prev_ids, hidden,
+        _contexts(serve, target_hidden, anchor_ids[0].repeat(BS), PREFIX),
+    ).float()
+    blind = (expected - shared).abs().max().item()
+    assert blind > TOL * scale, (
+        f"{gate_mode}: giving every row the SAME anchor moved the result by only "
+        f"{blind:.3e}, within the {TOL * scale:.3e} tolerance -- this test cannot "
+        f"detect a shared-anchor bug and is not testing what it claims to."
+    )
+
+
+@cuda_only
+def test_empty_prefix_gives_exactly_the_anchor():
+    """cache_seqlens = 0 leaves the anchor as the only key, so the attention output must
+    be its value exactly.  The merge divides by exp(lse) + exp(score) and lse is -inf
+    here; getting that wrong yields NaN, which a tolerance-based test would not localise."""
+    _, serve, _ = _pair()
+    torch.manual_seed(2)
+    dev = "cuda"
+    target_hidden = torch.randn(BS, PREFIX, HIDDEN, device=dev, dtype=torch.bfloat16)
+    anchor_ids = torch.randint(0, VOCAB, (BS,), device=dev)
+    context = _contexts(serve, target_hidden, anchor_ids, PREFIX)
+    # cache_seqlens = 1 leaves only the anchor (column 0 of the table is the anchor slot
+    # once prefix_lens is 0), so the attention output must be its value exactly.
+    context = serve.build_serving_context(
+        page_table=torch.zeros(BS, 2, dtype=torch.int32, device=dev),
+        prefix_lens=torch.zeros(BS, dtype=torch.int32, device=dev),
+        anchor_token_ids=anchor_ids,
+        anchor_cache_loc=torch.full((BS,), 1, dtype=torch.long, device=dev),
+    )
+
+    query = torch.randn(BS, HEADS, HEAD_DIM, device=dev, dtype=torch.bfloat16)
+    with torch.no_grad():
+        out = serve._attend(query, context)
+    assert torch.isfinite(out.float()).all(), "empty prefix produced non-finite output"
+    expected = serve._value_cache[1, 0].reshape(1, -1).expand(BS, -1).float()
+    err = (out.float() - expected).abs().max().item()
+    assert err <= 2e-2, f"empty prefix did not reduce to the anchor: {err:.3e}"
+
+
+@cuda_only
+def test_the_page_table_is_actually_used():
+    """The cache is paged, so slot order is arbitrary.  Permuting the page table together
+    with the rows it points at must not change the answer; permuting only the table
+    must."""
+    _, serve, _ = _pair()
+    torch.manual_seed(3)
+    dev = "cuda"
+    target_hidden = torch.randn(BS, PREFIX, HIDDEN, device=dev, dtype=torch.bfloat16)
+    anchor_ids = torch.randint(0, VOCAB, (BS,), device=dev)
+    context = _contexts(serve, target_hidden, anchor_ids, PREFIX)
+    query = torch.randn(BS, HEADS, HEAD_DIM, device=dev, dtype=torch.bfloat16)
+    with torch.no_grad():
+        base = serve._attend(query, context).float()
+        scrambled = AttnHeadContext(
+            key_cache=context.key_cache,
+            value_cache=context.value_cache,
+            # Over ALL the covered columns: cache_seqlens is prefix + 1 now, so the
+            # anchor's column is inside the window and permuting only the first PREFIX
+            # would drop it -- a different key set, not a reordering.
+            page_table=context.page_table[
+                :, torch.randperm(context.page_table.shape[1], device=dev)
+            ],
+            cache_seqlens=context.cache_seqlens,
+        )
+        truncated = AttnHeadContext(
+            key_cache=context.key_cache,
+            value_cache=context.value_cache,
+            page_table=context.page_table,
+            cache_seqlens=torch.full((BS,), PREFIX // 2, dtype=torch.int32, device=dev),  # noqa: E501
+        )
+        after_scramble = serve._attend(query, scrambled).float()
+        after_truncate = serve._attend(query, truncated).float()
+
+    # TOLERANCES ARE RELATIVE TO THE OUTPUT'S OWN SCALE.  A first version of this test
+    # used atol=2e-2 on values whose RMS is ~5e-3, so allclose was true no matter what
+    # and BOTH assertions were vacuous -- including the one that passed.
+    scale = base.abs().max().item()
+    scrambled_err = (base - after_scramble).abs().max().item()
+    truncated_err = (base - after_truncate).abs().max().item()
+    # Attention is permutation invariant in its keys, so reordering the table over the
+    # same set of slots is a no-op.
+    assert scrambled_err <= 0.05 * scale, (
+        f"reordering the page table moved the output by {scrambled_err:.3e} "
+        f"on a scale of {scale:.3e}"
+    )
+    assert truncated_err > 0.05 * scale, (
+        f"halving the prefix moved the output by only {truncated_err:.3e} on a scale of "
+        f"{scale:.3e} -- the cache is probably not being read"
+    )
diff --git a/test/srt/speculative/test_attn_head_precompute.py b/test/srt/speculative/test_attn_head_precompute.py
new file mode 100644
index 0000000000..ad92529748
--- /dev/null
+++ b/test/srt/speculative/test_attn_head_precompute.py
@@ -0,0 +1,124 @@
+# Added relative to sgl-project/sglang@702de2631 for DSpark prefix-attention drafter serving (specfloor, serving/sglang).
+"""Inference factoring against the original head, including reload and graph replay."""
+
+import pytest
+import torch
+
+from sglang.srt.models.dspark import AttnHead, AttnHeadContext, build_markov_lattice
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+
+
+def make_head(gate_mode, dtype):
+    torch.manual_seed(42)
+    head = (
+        AttnHead(
+            vocab_size=256,
+            hidden_size=128,
+            markov_rank=64,
+            num_heads=2,
+            head_dim=32,
+            mlp_hidden=96,
+            gate_mode=gate_mode,
+            rms_norm_eps=1e-6,
+            anchor_kv=False,
+        )
+        .cuda()
+        .to(dtype)
+        .eval()
+    )
+    embed = torch.nn.Embedding(256, 128).cuda().to(dtype)
+    head.set_embedding_source(embed)
+    return head
+
+
+@torch.no_grad()
+@pytest.mark.parametrize("gate_mode", ["none", "state", "state_output"])
+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float16])
+def test_lattice_matches_uncached_and_sequential(gate_mode, dtype, monkeypatch):
+    head = make_head(gate_mode, dtype)
+    bs, slots, top_k, prefix = 2, 3, 5, 11
+    keys = torch.randn(bs * prefix, 1, 2, 32, device="cuda", dtype=dtype)
+    context = AttnHeadContext(
+        key_cache=keys,
+        value_cache=torch.randn_like(keys),
+        page_table=torch.randperm(bs * prefix, device="cuda").view(bs, prefix).int(),
+        cache_seqlens=torch.tensor([7, prefix], device="cuda", dtype=torch.int32),
+    )
+    hidden = torch.randn(bs, slots + 1, 128, device="cuda", dtype=dtype)[:, 1:]
+    candidates = torch.randint(256, (bs, slots, top_k), device="cuda")
+    unary = torch.randn(bs, slots, top_k, device="cuda")
+    anchors = torch.tensor([1, 7], device="cuda")
+    kwargs = dict(
+        candidate_ids=candidates,
+        unary_logits=unary,
+        hidden_states=hidden,
+        anchor_token_ids=anchors,
+        context=context,
+    )
+    expected = build_markov_lattice(head, **kwargs)
+    prev = head.get_prev_embeddings(candidates)
+    state_keys = list(head.state_dict())
+    monkeypatch.setenv("SGLANG_DSPARK_ATTN_PRECOMPUTE", "1")
+    head.prepare_for_inference()
+    actual = build_markov_lattice(head, **kwargs)
+    assert list(head.state_dict()) == state_keys
+    torch.testing.assert_close(actual, expected, atol=0.02, rtol=0.02)
+    torch.testing.assert_close(
+        head.get_prev_embeddings(candidates), prev, atol=0.002, rtol=0.01
+    )
+    # A predecessor change must remain visible after factoring.
+    assert (actual[:, 1:, 0] - actual[:, 1:, 1]).abs().max() > 0.05
+    for slot in range(slots):
+        pred = anchors if slot == 0 else candidates[:, slot - 1, 2]
+        bias = head.compute_step_bias(pred, hidden[:, slot], context)
+        want = unary[:, slot] + bias.float().gather(1, candidates[:, slot])
+        torch.testing.assert_close(actual[:, slot, 2], want, atol=0.02, rtol=0.02)
+
+
+@torch.no_grad()
+def test_projection_preserves_fp32_partials_and_refreshes_graph(monkeypatch):
+    head = make_head("none", torch.bfloat16)
+    tokens = torch.tensor([1, 2, 3, 4], device="cuda")
+    hidden = torch.randn(2, 128, device="cuda", dtype=torch.bfloat16)
+    monkeypatch.setenv("SGLANG_DSPARK_ATTN_PRECOMPUTE", "1")
+    head.prepare_for_inference()
+
+    # Independent FP64 arithmetic reference with the same normalized BF16 inputs.
+    def reference():
+        e = head.embed_norm(head.embed_tokens(tokens))
+        h = head.state_norm(hidden).repeat_interleave(2, 0)
+        return (
+            torch.cat([e, h], -1).double() @ head.in_proj.weight.double().T
+        ).bfloat16()
+
+    torch.testing.assert_close(
+        head._project_inputs(tokens, hidden, 2), reference(), atol=0.001, rtol=0.008
+    )
+    stream = torch.cuda.Stream()
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        for _ in range(3):
+            head._project_inputs(tokens, hidden, 2)
+    torch.cuda.current_stream().wait_stream(stream)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        output = head._project_inputs(tokens, hidden, 2)
+    graph.replay()
+    before = output.clone()
+    addresses = (
+        head._projected_embedding.data_ptr(),
+        head._state_projection_weight.data_ptr(),
+    )
+    head.in_proj.weight.mul_(1.25)
+    head._embed_tokens.weight.add_(0.1)
+    head.prepare_for_inference()
+    assert addresses == (
+        head._projected_embedding.data_ptr(),
+        head._state_projection_weight.data_ptr(),
+    )
+    tokens.copy_(tokens.flip(0))
+    hidden.mul_(0.5)
+    graph.replay()
+    torch.testing.assert_close(output, reference(), atol=0.001, rtol=0.008)
+    assert not torch.equal(output, before)
diff --git a/test/srt/speculative/test_cross_self_split.py b/test/srt/speculative/test_cross_self_split.py
new file mode 100644
index 0000000000..b3c33a864a
--- /dev/null
+++ b/test/srt/speculative/test_cross_self_split.py
@@ -0,0 +1,150 @@
+# Added relative to sgl-project/sglang@702de2631 for DSpark prefix-attention drafter serving (specfloor, serving/sglang).
+"""The cross/self split: sglang's DFlashBlockSelfAttention and slot_embed against training.
+
+Both are additive modules whose weights come straight from the checkpoint, so the only
+question that matters is whether the serving copy computes what the training copy did.
+Asserted against the training module with the same weights, as everywhere else in this
+port -- a smoke test would be produced by the code path whose correctness is in question.
+
+Run: /workspace/sglang-eval-env/bin/python -m pytest <this file> -q
+"""
+import contextlib
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from sglang.srt.models.dflash import DFlashBlockSelfAttention
+
+HIDDEN = 256
+BLOCK = 7
+HEADS = 4
+HEAD_DIM = 64
+EPS = 1e-6
+BLOCKS = 3
+
+
+@contextlib.contextmanager
+def _rms_norm_native():
+    """sglang RMSNorm.forward is the sgl_kernel CUDA op with no CPU fallback; the
+    fp32 exactness comparison has to name which implementation it is measuring."""
+    from sglang.srt.layers.layernorm import RMSNorm
+
+    original = RMSNorm.forward
+    RMSNorm.forward = RMSNorm.forward_native
+    try:
+        yield
+    finally:
+        RMSNorm.forward = original
+
+
+def _pair(causal=False):
+    _m = pytest.importorskip(
+        "deepspec.modeling.dspark.qwen3.modeling",
+        reason="the training-side reference lives in the DeepSpec repo, which this project neither vendors nor declares as a dependency. Skipping means this parity check does NOT run here -- the serving module is unverified against the one the weights were trained with.",
+    )
+    DSparkBlockSelfAttention = _m.DSparkBlockSelfAttention
+
+    config = SimpleNamespace(
+        hidden_size=HIDDEN,
+        block_size=BLOCK,
+        cross_self_q_heads=HEADS,
+        cross_self_head_dim=HEAD_DIM,
+        head_dim=HEAD_DIM,
+        num_attention_heads=HIDDEN // HEAD_DIM,
+        rms_norm_eps=EPS,
+        attention_bias=False,
+        causal_draft_mask=causal,
+    )
+    torch.manual_seed(0)
+    train = DSparkBlockSelfAttention(config, 0)
+    serve = DFlashBlockSelfAttention(
+        hidden_size=HIDDEN, block_size=BLOCK, num_heads=HEADS, head_dim=HEAD_DIM,
+        rms_norm_eps=EPS, attention_bias=False, causal=causal,
+    )
+    # pair_bias is zero-initialised in training, so leaving it would compare the module
+    # WITHOUT the one parameter that carries its position model.
+    with torch.no_grad():
+        for param in train.parameters():
+            param.normal_(0.0, 0.05)
+        missing, unexpected = serve.load_state_dict(train.state_dict(), strict=False)
+    assert not unexpected, f"the serving module has no home for {unexpected}"
+    assert not missing, f"the serving module wants weights training never had: {missing}"
+    return train.eval(), serve.eval()
+
+
+@pytest.mark.parametrize("causal", [False, True])
+def test_block_self_matches_training(causal):
+    train, serve = _pair(causal)
+    torch.manual_seed(1)
+    tokens = BLOCKS * BLOCK
+    flat = torch.randn(tokens, HIDDEN)
+    with _rms_norm_native(), torch.no_grad():
+        # Training takes [batch, blocks * K, hidden]; sglang's draft model is flat.
+        expected = train(flat.view(1, tokens, HIDDEN)).view(tokens, HIDDEN)
+        actual = serve(flat)
+    err = (expected - actual).abs().max().item()
+    assert err <= 2e-5, f"causal={causal}: max|train - serve| = {err:.3e}"
+
+
+def test_state_dict_keys_match_the_checkpoint():
+    train, serve = _pair()
+    assert {k: tuple(v.shape) for k, v in train.state_dict().items()} == {
+        k: tuple(v.shape) for k, v in serve.state_dict().items()
+    }
+
+
+def test_blocks_do_not_leak_into_each_other():
+    """Rows of different blocks are different draft attempts.  If they mixed, the module
+    would score a blend of continuations that never co-occur."""
+    _, serve = _pair()
+    torch.manual_seed(2)
+    x = torch.randn(2 * BLOCK, HIDDEN)
+    with _rms_norm_native(), torch.no_grad():
+        base = serve(x)
+        bumped = x.clone()
+        bumped[0] += 10.0
+        after = serve(bumped)
+    moved = (after - base).abs().amax(dim=-1)
+    assert moved[BLOCK:].max().item() == 0.0, f"block 1 moved: {moved[BLOCK:]}"
+    assert moved[:BLOCK].max().item() > 0.0, "block 0 did not move at all"
+
+
+def test_slot_embed_matches_training():
+    """slot_embed adds a per-slot vector to slots 1..K-1 and leaves slot 0 alone -- slot 0
+    carries the real anchor token and already has an identity.  Off by one here would be
+    invisible: every slot would still get A vector, just the wrong one."""
+    torch.manual_seed(3)
+    slot_embed = torch.randn(BLOCK - 1, HIDDEN) * 0.02
+    tokens = BLOCKS * BLOCK
+    flat = torch.randn(tokens, HIDDEN)
+
+    # training: [b, L, d], cat([slot 0, slots 1: + slot_embed])
+    blocks = flat.view(1, BLOCKS, BLOCK, HIDDEN)
+    expected = torch.cat(
+        [blocks[:, :, :1], blocks[:, :, 1:] + slot_embed], dim=2
+    ).reshape(tokens, HIDDEN)
+
+    class _Model:
+        block_size = BLOCK
+
+    from sglang.srt.models.dflash import DFlashDraftModel
+
+    model = _Model()
+    model.slot_embed = slot_embed
+    actual = DFlashDraftModel._add_slot_embed(model, flat)
+    assert torch.equal(expected, actual)
+    assert torch.equal(actual[0], flat[0]), "slot 0 must be untouched"
+    assert not torch.equal(actual[1], flat[1]), "slot 1 must be shifted"
+
+
+def test_slot_embed_refuses_a_ragged_tail():
+    from sglang.srt.models.dflash import DFlashDraftModel
+
+    class _Model:
+        block_size = BLOCK
+
+    model = _Model()
+    model.slot_embed = torch.zeros(BLOCK - 1, HIDDEN)
+    with pytest.raises(ValueError, match="whole blocks"):
+        DFlashDraftModel._add_slot_embed(model, torch.randn(BLOCK * 2 - 1, HIDDEN))
diff --git a/test/srt/speculative/test_dflash2_conv_parity.py b/test/srt/speculative/test_dflash2_conv_parity.py
new file mode 100644
index 0000000000..71234e6c6d
--- /dev/null
+++ b/test/srt/speculative/test_dflash2_conv_parity.py
@@ -0,0 +1,115 @@
+# Added relative to sgl-project/sglang@702de2631 for DSpark prefix-attention drafter serving (specfloor, serving/sglang).
+"""Upstream's DFlashGroupedConv vs the DSpark trainer's DSparkGroupedDynamicConv.
+
+The two carry the SAME module names (`attention_conv`, `mlp_conv`) and the SAME parameter
+shapes (`base_kernel [2, taps, hidden]`, `kernel_projection.weight`), which means a
+trained checkpoint loads into upstream sglang without a single line of modeling code --
+and means nothing at all about whether it then computes the same thing.  This project has
+already shipped a conv that matched its reference's parameter count exactly (16,486,400)
+while computing a different function, because the wiring differed.  Identical names are a
+stronger coincidence than identical counts and still not a proof.
+
+So: same weights, same input, compare outputs.  If this passes, dflash2_conv-trained
+checkpoints serve on stock upstream sglang.  If it fails, the difference it finds is the
+port that has to be written.
+
+Run: /workspace/sglang-eval-env/bin/python -m pytest <this file> -q
+"""
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from sglang.srt.models.dflash import DFlashGroupedConv
+
+HIDDEN = 128
+BLOCK = 7
+TAPS = 2
+GROUP = 16
+BLOCKS = 3
+
+
+def _trainer_conv():
+    _m = pytest.importorskip(
+        "deepspec.modeling.dspark.qwen3.modeling",
+        reason="the training-side reference lives in the DeepSpec repo, which this project neither vendors nor declares as a dependency. Skipping means this parity check does NOT run here -- the serving module is unverified against the one the weights were trained with.",
+    )
+    DSparkGroupedDynamicConv = _m.DSparkGroupedDynamicConv
+
+    config = SimpleNamespace(
+        hidden_size=HIDDEN,
+        block_size=BLOCK,
+        dflash2_conv_kernel_size=TAPS,
+        short_conv_group_size=GROUP,
+    )
+    return DSparkGroupedDynamicConv(config, "test")
+
+
+def _pair():
+    torch.manual_seed(0)
+    train = _trainer_conv()
+    serve = DFlashGroupedConv(HIDDEN, BLOCK, TAPS, GROUP)
+    # Identity init on both sides would make prepare/finish the identity and compare
+    # x against x, which is exactly the comparison that cannot fail.
+    with torch.no_grad():
+        train.base_kernel.normal_(0.0, 0.5)
+        train.kernel_projection.weight.normal_(0.0, 0.05)
+        serve.base_kernel.copy_(train.base_kernel)
+        serve.kernel_projection.weight.copy_(train.kernel_projection.weight)
+    return train.eval(), serve.eval()
+
+
+def test_parameter_names_and_shapes_match():
+    train, serve = _pair()
+    train_shapes = {k: tuple(v.shape) for k, v in train.state_dict().items()}
+    serve_shapes = {k: tuple(v.shape) for k, v in serve.state_dict().items()}
+    assert train_shapes == serve_shapes, f"{train_shapes} != {serve_shapes}"
+
+
+def test_prepare_and_finish_compute_the_same_function():
+    """LAYOUTS DIFFER AND THAT IS NOT A DIFFERENCE IN THE FUNCTION.  The trainer works on
+    [batch, blocks * block_size, hidden]; sglang's draft model is flat, [tokens, hidden],
+    and recovers the within-block position as (flat index % block_size).  Feeding both
+    their own view of the SAME tokens is the comparison; feeding both the same tensor
+    would only measure that they disagree about what a dimension means."""
+    train, serve = _pair()
+    torch.manual_seed(1)
+    tokens = BLOCKS * BLOCK
+    flat = torch.randn(tokens, HIDDEN)
+
+    with torch.no_grad():
+        train_in, train_kernel = train.prepare(flat.view(1, tokens, HIDDEN))
+        serve_in, serve_kernel = serve.prepare(flat)
+    train_in = train_in.view(tokens, HIDDEN)
+    err_in = (train_in - serve_in).abs().max().item()
+    assert err_in <= 2e-5, f"prepare() differs by {err_in:.3e}"
+
+    torch.manual_seed(2)
+    sublayer_out = torch.randn(tokens, HIDDEN)
+    with torch.no_grad():
+        train_out = train.finish(
+            sublayer_out.view(1, tokens, HIDDEN), train_kernel
+        ).view(tokens, HIDDEN)
+        serve_out = serve.finish(sublayer_out, serve_kernel)
+    err_out = (train_out - serve_out).abs().max().item()
+    assert err_out <= 2e-5, f"finish() differs by {err_out:.3e}"
+
+
+def test_the_conv_is_block_causal():
+    """Slot t may read t and t-1 WITHIN its block and nothing else.  Perturbing the last
+    slot of block 0 must leave every slot of block 1 untouched -- if the port silently
+    convolved across the block boundary, accept length would look fine and the draft
+    would be reading a token it does not have at serving time."""
+    _, serve = _pair()
+    torch.manual_seed(3)
+    x = torch.randn(2 * BLOCK, HIDDEN)
+    with torch.no_grad():
+        base, _ = serve.prepare(x)
+        bumped = x.clone()
+        bumped[BLOCK - 1] += 10.0
+        after, _ = serve.prepare(bumped)
+    moved = (after - base).abs().amax(dim=-1)
+    assert moved[BLOCK:].max().item() == 0.0, (
+        f"block 1 moved when block 0 changed: {moved[BLOCK:]}"
+    )
+    assert moved[BLOCK - 1].item() > 0.0, "the perturbed slot itself did not move"
diff --git a/test/srt/speculative/test_lattice_proposal_q.py b/test/srt/speculative/test_lattice_proposal_q.py
new file mode 100644
index 0000000000..fb35caeb58
--- /dev/null
+++ b/test/srt/speculative/test_lattice_proposal_q.py
@@ -0,0 +1,85 @@
+# Added relative to sgl-project/sglang@702de2631 for DSpark prefix-attention drafter serving (specfloor, serving/sglang).
+"""The lattice's dense q must be exactly the walk's q -- and must carry nothing else.
+
+Speculative sampling is lossless only when the distribution a token was drawn from is the
+one the verifier scores it against. The lattice proposal hands its q to the accept path as
+PROBABILITIES scattered into a persistent dense buffer (dflash_worker_v2 does the same,
+for the reason its own comment gives: "A fresh dense q would zero the whole vocabulary to
+carry top_k per row"). Two things can go wrong, and neither raises:
+
+  WRONG TEMPERATURE.  An earlier version routed q through the logits field, so the accept
+  path's SoftmaxTemp divided by the temperature a second time and the verifier scored
+  against softmax(scores/T^2). Measured at T=0.7: up to 0.22 of absolute probability mass
+  apart, a ratio between 0.03 and 1.47. Invisible at T=0 (greedy accept never reads the
+  field) and at T=1 (T^2 == T), which is every temperature this repo measures at.
+
+  STALE MASS.  The buffer persists, so a round that does not clear the PREVIOUS round's
+  entries leaves the verifier probability on tokens this round never proposed.
+
+Run: /workspace/sglang-eval-env/bin/python -m pytest <this file> -q
+"""
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from sglang.kernels.ops.speculative.dflash import selector_walk_triton
+
+pytestmark = pytest.mark.skipif(
+    not torch.cuda.is_available(), reason="selector_walk_triton is a triton kernel")
+
+BS, SLOTS, K, V = 4, 7, 16, 256
+
+
+class _Sink:
+    """_lattice_draft_probs' buffer discipline, standalone (no model to construct)."""
+
+    def __init__(self):
+        self.buf = None
+        self.dirty = None
+
+    def __call__(self, candidate_ids, q_rows):
+        bs, gamma, _ = candidate_ids.shape
+        if self.buf is None:
+            self.buf = torch.zeros((bs, gamma, V), dtype=torch.float32,
+                                   device=candidate_ids.device)
+            self.dirty = None
+        if self.dirty is not None:
+            prev_ids, prev_bs = self.dirty
+            self.buf[:prev_bs].scatter_(-1, prev_ids, 0.0)
+        probs = self.buf[:bs]
+        probs.scatter_(-1, candidate_ids, q_rows.float())
+        self.dirty = (candidate_ids.clone(), bs)
+        return probs
+
+
+def _round(seed, temperature, sink):
+    dev = "cuda"
+    g = torch.Generator(device=dev).manual_seed(seed)
+    cand = torch.stack([torch.randperm(V, device=dev, generator=g)[:K]
+                        for _ in range(BS * SLOTS)]).view(BS, SLOTS, K)
+    scores = torch.randn(BS, SLOTS, K, K, device=dev, generator=g)
+    temps = torch.full((BS,), temperature, device=dev, dtype=torch.float32)
+    _, q_rows = selector_walk_triton(
+        candidate_ids=cand, scores=scores,
+        uniforms=torch.rand(BS, SLOTS, device=dev, generator=g), temperatures=temps,
+        greedy_mask=torch.zeros(BS, dtype=torch.bool, device=dev))
+    return cand, q_rows, sink(cand, q_rows)
+
+
+@pytest.mark.parametrize("temperature", [0.5, 0.7, 1.0, 1.5])
+def test_dense_q_equals_the_walks_q(temperature):
+    cand, q_rows, probs = _round(0, temperature, _Sink())
+    assert (probs.gather(-1, cand) - q_rows).abs().max().item() < 1e-6
+    # and no temperature was applied on the way in or out
+    assert abs(probs.sum(-1).mean().item() - 1.0) < 1e-4
+
+
+def test_no_stale_mass_from_the_previous_round():
+    sink = _Sink()
+    cand0, _, _ = _round(0, 0.7, sink)
+    cand1, q1, probs = _round(1, 0.7, sink)
+    assert (probs.gather(-1, cand1) - q1).abs().max().item() < 1e-6
+    # every column not in THIS round's candidate set must be exactly zero, including the
+    # ones the previous round wrote
+    total = probs.sum(-1)
+    assert (total - q1.sum(-1)).abs().max().item() < 1e-5, "stale mass from round 0"
diff --git a/test/srt/speculative/test_markov_lattice.py b/test/srt/speculative/test_markov_lattice.py
new file mode 100644
index 0000000000..c64289d793
--- /dev/null
+++ b/test/srt/speculative/test_markov_lattice.py
@@ -0,0 +1,189 @@
+# Added relative to sgl-project/sglang@702de2631 for DSpark prefix-attention drafter serving (specfloor, serving/sglang).
+"""The lattice must be the SAME FUNCTION as the sequential walk, restricted to the
+candidate set.
+
+These heads are trained with a nomination CE on the unary head (nominate_alpha > 0,
+nominate_topk = 16), whose content is M16 = sum_{b in Top16(u)} p(b): u is trained so
+its top-16 contains the answer and the order-1 head reranks inside it.  The lattice is
+therefore the serving form, and the only thing worth asserting about it is that it
+computes what the sequential path computes -- score[b,l,p,c] must equal
+base_logits[b,l,cand[c]] + compute_step_bias(pred[l,p], h[l])[cand[c]] exactly.
+
+Every test here carries a SENSITIVITY assertion beside its parity assertion.  A lattice
+that ignored the predecessor entirely would satisfy parity on p=0 alone, and a tolerance
+picked for comfort hides exactly that; the pair is what makes the check mean something.
+"""
+
+import pytest
+import torch
+
+from sglang.srt.models.dspark import (
+    AttnHead,
+    AttnHeadContext,
+    VanillaMarkov,
+    build_markov_lattice,
+)
+
+BS, SLOTS, TOP_K = 3, 4, 5
+VOCAB, HIDDEN, RANK = 128, 32, 16
+HEADS, HEAD_DIM, PREFIX = 2, 8, 7
+
+cuda_only = pytest.mark.skipif(
+    not torch.cuda.is_available(), reason="the attention head needs a GPU kernel"
+)
+
+
+def _inputs(device, dtype=torch.float32):
+    torch.manual_seed(0)
+    base = torch.randn(BS, SLOTS, VOCAB, device=device, dtype=dtype)
+    hidden = torch.randn(BS, SLOTS, HIDDEN, device=device, dtype=dtype)
+    anchor = torch.randint(0, VOCAB, (BS,), device=device)
+    unary, cand = base.topk(TOP_K, dim=-1)
+    return base, hidden, anchor, unary, cand
+
+
+def _predecessors(cand, anchor):
+    """[BS, SLOTS, TOP_K]: slot 0 takes the anchor, slot l>0 takes slot l-1's candidates."""
+    first = anchor[:, None, None].expand(-1, 1, TOP_K)
+    return torch.cat([first, cand[:, :-1]], dim=1)
+
+
+def _reference(head, base, hidden, pred, cand, **kw):
+    """The sequential path's answer, one (slot, predecessor) at a time."""
+    out = torch.empty(BS, SLOTS, TOP_K, TOP_K, device=base.device, dtype=torch.float32)
+    for l in range(SLOTS):
+        for p in range(TOP_K):
+            bias = head.compute_step_bias(pred[:, l, p], hidden[:, l], **kw).float()
+            ids = cand[:, l]                                        # [BS, TOP_K]
+            out[:, l, p] = base[:, l].float().gather(1, ids) + bias.gather(1, ids)
+    return out
+
+
+def _check(got, want, *, label):
+    err = (got.float() - want).abs().max().item()
+    assert err < 2e-2, f"{label}: lattice disagrees with the sequential walk by {err:.3e}"
+
+    # Sensitivity: the scores must actually depend on WHICH predecessor indexes p.
+    # Without this, a head that dropped the predecessor would pass the assertion above.
+    spread = (want - want[:, :, :1]).abs().max().item()
+    assert spread > 10 * err, (
+        f"{label}: predecessors move the score by only {spread:.3e} against a "
+        f"{err:.3e} parity error -- this comparison cannot see the predecessor at all."
+    )
+
+
+def test_vanilla_lattice_matches_the_sequential_walk():
+    torch.manual_seed(1)
+    head = VanillaMarkov(vocab_size=VOCAB, markov_rank=RANK).float().eval()
+    base, hidden, anchor, unary, cand = _inputs("cpu")
+    with torch.no_grad():
+        got = build_markov_lattice(
+            head, candidate_ids=cand, unary_logits=unary,
+            hidden_states=hidden, anchor_token_ids=anchor,
+        )
+        want = _reference(head, base, hidden, _predecessors(cand, anchor), cand)
+    _check(got, want, label="vanilla")
+
+
+@cuda_only
+def test_attn_lattice_matches_the_sequential_walk():
+    """The attention head is the one where parallelising is not obviously allowed.
+
+    It is: the predecessor enters only through the token embedding, and the keys are
+    the committed prefix, which no predecessor changes.  So SLOTS*TOP_K queries share
+    one page table and one cache_seqlens -- a single kernel launch.  If that were wrong
+    the scores would come back mixed across slots and this parity would fail.
+    """
+    torch.manual_seed(3)
+    dev = "cuda"
+    head = AttnHead(
+        vocab_size=VOCAB, markov_rank=RANK, hidden_size=HIDDEN, num_heads=HEADS,
+        head_dim=HEAD_DIM, mlp_hidden=2 * RANK, gate_mode="none", rms_norm_eps=1e-6,
+    ).to(dev).to(torch.bfloat16).eval()
+    head.set_embedding_source(
+        torch.nn.Embedding(VOCAB, HIDDEN).to(dev).to(torch.bfloat16)
+    )
+    base, hidden, anchor, unary, cand = _inputs(dev, torch.bfloat16)
+
+    slots_total = BS * (PREFIX + 2)
+    key = torch.zeros(slots_total, 1, HEADS, HEAD_DIM, device=dev, dtype=torch.bfloat16)
+    val = torch.zeros_like(key)
+    perm = torch.randperm(slots_total - BS, device=dev)[: BS * PREFIX].view(BS, PREFIX)
+    with torch.no_grad():
+        k, v = head.context_kv(
+            torch.randn(BS * PREFIX, HIDDEN, device=dev, dtype=torch.bfloat16)
+        )
+        key[perm.reshape(-1), 0] = k
+        val[perm.reshape(-1), 0] = v
+    head._key_cache, head._value_cache = key, val
+    with torch.no_grad():
+        ctx = head.build_serving_context(
+            page_table=torch.cat(
+                [perm, torch.zeros(BS, 1, dtype=perm.dtype, device=dev)], dim=1
+            ),
+            prefix_lens=torch.full((BS,), PREFIX, dtype=torch.int32, device=dev),
+            anchor_token_ids=anchor,
+            # One reserved row per request: a shared row makes the anchor write an
+            # advanced-index write with duplicate indices, where one value survives.
+            anchor_cache_loc=torch.arange(
+                slots_total - BS, slots_total, device=dev, dtype=torch.long
+            ),
+        )
+        got = build_markov_lattice(
+            head, candidate_ids=cand, unary_logits=unary,
+            hidden_states=hidden, anchor_token_ids=anchor, context=ctx,
+        )
+        want = _reference(
+            head, base, hidden, _predecessors(cand, anchor), cand, context=ctx
+        )
+    _check(got, want, label="attn")
+
+
+def test_rnn_head_refuses_the_lattice():
+    """An order-1 lattice cannot represent a state carried across slots, and serving a
+    wrong-but-plausible proposal is worse than refusing."""
+    from sglang.srt.models.dspark import RNNHead
+
+    head = RNNHead(vocab_size=VOCAB, markov_rank=RANK, hidden_size=HIDDEN).float()
+    with pytest.raises(NotImplementedError, match="recurrent state"):
+        head.compute_step_latent(
+            torch.zeros(2, dtype=torch.long), torch.zeros(2, HIDDEN)
+        )
+
+
+@cuda_only
+def test_full_width_lattice_reproduces_the_sequential_walk_exactly():
+    """At top_k = vocab the candidate set IS the vocabulary, so the lattice walk and the
+    full-vocabulary sequential walk are the same greedy chain -- token for token.
+
+    This is the equivalence the whole change rests on: the lattice is not an
+    approximation of the sequential proposal, it is that proposal restricted to a
+    candidate set. Any disagreement here is a bug in the walk or in the predecessor
+    wiring, not a candidate-set effect, because at full width there is no restriction.
+    """
+    from sglang.srt.speculative.dspark_components.dspark_draft import _propose_by_lattice
+
+    torch.manual_seed(4)
+    dev = "cuda"
+    head = VanillaMarkov(vocab_size=VOCAB, markov_rank=RANK).to(dev).float().eval()
+    base, hidden, anchor, _, _ = _inputs(dev)
+
+    with torch.no_grad():
+        got = _propose_by_lattice(
+            base_logits=base, anchor_tokens=anchor, draft_hidden=hidden,
+            markov_head=head, head_context=None, top_k=VOCAB,
+            greedy_mask=torch.ones(BS, dtype=torch.bool, device=dev),
+            temperatures=torch.ones(BS, dtype=torch.float32, device=dev),
+            any_sampling=False, device=dev,
+        ).draft_tokens
+
+        prev, want = anchor, []
+        for l in range(SLOTS):
+            step = base[:, l] + head.compute_step_bias(prev, hidden[:, l])
+            prev = step.argmax(-1)
+            want.append(prev)
+        want = torch.stack(want, dim=1)
+
+    assert torch.equal(got, want), (
+        f"full-width lattice disagrees with the sequential walk:\n{got}\n{want}"
+    )
diff --git a/test/srt/speculative/test_short_conv_decode.py b/test/srt/speculative/test_short_conv_decode.py
new file mode 100644
index 0000000000..dadf2c3064
--- /dev/null
+++ b/test/srt/speculative/test_short_conv_decode.py
@@ -0,0 +1,86 @@
+# Added relative to sgl-project/sglang@702de2631 for DSpark prefix-attention drafter serving (specfloor, serving/sglang).
+"""Decode fusion vs independent projection/convolution math and real checkpoints."""
+
+import pytest
+import torch
+
+from sglang.kernels.ops.speculative.dflash_short_conv import short_conv_decode
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+
+
+def reference(x, weight, base, block_size, group_size):
+    tokens, hidden = x.shape
+    taps = base.shape[0]
+    # FP64 reference for the projection, rounded once as F.linear would be.
+    gate = (x.double() @ weight.double().T).to(x.dtype).float()
+    gate = gate.reshape(tokens, taps, hidden // group_size).repeat_interleave(
+        group_size, -1
+    )
+    out = torch.zeros_like(x, dtype=torch.float32)
+    for t in range(tokens):
+        for tap in range(min(t % block_size + 1, taps)):
+            out[t] += (base[tap].float() + gate[t, tap]) * x[t - tap].float()
+    return out.to(x.dtype)
+
+
+@torch.no_grad()
+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float16])
+@pytest.mark.parametrize(
+    "tokens,hidden,block,group,taps",
+    [
+        (1, 128, 7, 16, 2),
+        (7, 2560, 8, 16, 2),
+        (8, 2560, 8, 16, 2),
+        (16, 2560, 8, 16, 2),
+        (31, 768, 7, 8, 2),
+        (32, 4096, 8, 32, 1),
+    ],
+)
+def test_matches_reference(dtype, tokens, hidden, block, group, taps):
+    torch.manual_seed(42)
+    x = torch.randn(tokens, hidden, device="cuda", dtype=dtype)
+    weight = (
+        torch.randn(taps * hidden // group, hidden, device="cuda", dtype=dtype) * 0.02
+    )
+    base = torch.randn(taps, hidden, device="cuda", dtype=dtype) * 0.2
+    expected = reference(x, weight, base, block, group)
+    actual = short_conv_decode(x, weight, base, block, group)
+    # FP32 accumulation order can flip a gate across a low-precision rounding
+    # boundary. Bound the output error against an independent FP64 reference.
+    eps = torch.finfo(dtype).eps
+    assert (
+        actual.float() - expected.float()
+    ).abs().max() <= 2 * eps * expected.float().abs().max()
+    torch.testing.assert_close(actual, expected, atol=2 * eps, rtol=2 * eps)
+
+
+@torch.no_grad()
+def test_block_boundaries_and_graph_replay():
+    torch.manual_seed(7)
+    x = torch.randn(21, 256, device="cuda", dtype=torch.bfloat16)
+    weight = torch.randn(32, 256, device="cuda", dtype=x.dtype) * 0.02
+    base = torch.randn(2, 256, device="cuda", dtype=x.dtype)
+    fn = lambda: short_conv_decode(x, weight, base, 7, 16)
+    baseline = fn()
+    x[6].add_(10)
+    after = fn()
+    assert torch.equal(baseline[7:], after[7:])
+    assert not torch.equal(baseline[6], after[6])
+    stream = torch.cuda.Stream()
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        for _ in range(3):
+            fn()
+    torch.cuda.current_stream().wait_stream(stream)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        output = fn()
+    x.normal_()
+    graph.replay()
+    torch.testing.assert_close(output, fn(), atol=0, rtol=0)
+    weight.zero_()
+    base.zero_()
+    base[0].fill_(1)
+    graph.replay()
+    assert torch.equal(output, x)
diff --git a/test/srt/speculative/test_short_conv_parity.py b/test/srt/speculative/test_short_conv_parity.py
new file mode 100644
index 0000000000..5ca4f89135
--- /dev/null
+++ b/test/srt/speculative/test_short_conv_parity.py
@@ -0,0 +1,127 @@
+# Added relative to sgl-project/sglang@702de2631 for DSpark prefix-attention drafter serving (specfloor, serving/sglang).
+"""sglang's DFlashShortConv vs the DSpark trainer's DSparkShortConv.
+
+The trainer runs this operator through a fused triton kernel; sglang runs it through the
+`_grouped_conv` primitive that already serves the other conv wiring.  Two different
+implementations of one function, so the same rule applies as everywhere else in this
+port: assert against the training module with the same weights, do not smoke-test the
+copy against itself.
+
+The wiring is the point.  DFlashGroupedConv (already upstream) and DFlashShortConv differ
+ONLY in where the post-sublayer coefficients come from, and at 5 layers / hidden 2560 /
+group 16 they even have the same 16,486,400 parameters.  So there is a test below that
+would fail if the four modules were quietly collapsed into the two-sided form.
+
+Run: /workspace/sglang-eval-env/bin/python -m pytest <this file> -q
+"""
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from sglang.srt.models.dflash import DFlashShortConv
+
+HIDDEN = 128
+BLOCK = 7
+TAPS = 2
+GROUP = 16
+BLOCKS = 3
+
+
+def _pair():
+    _m = pytest.importorskip(
+        "deepspec.modeling.dspark.qwen3.modeling",
+        reason="the training-side reference lives in the DeepSpec repo, which this project neither vendors nor declares as a dependency. Skipping means this parity check does NOT run here -- the serving module is unverified against the one the weights were trained with.",
+    )
+    DSparkShortConv = _m.DSparkShortConv
+
+    config = SimpleNamespace(
+        hidden_size=HIDDEN, block_size=BLOCK, short_conv_group_size=GROUP
+    )
+    torch.manual_seed(0)
+    train = DSparkShortConv(config)
+    serve = DFlashShortConv(HIDDEN, BLOCK, TAPS, GROUP)
+    # Identity init on both sides makes the conv the identity, which compares x with x --
+    # the one comparison that cannot fail.
+    with torch.no_grad():
+        train.k_base.normal_(0.0, 0.5)
+        train.corr.weight.normal_(0.0, 0.05)
+        serve.k_base.copy_(train.k_base)
+        serve.corr.weight.copy_(train.corr.weight)
+    return train.eval(), serve.eval()
+
+
+def test_parameter_names_and_shapes_match():
+    train, serve = _pair()
+    assert {k: tuple(v.shape) for k, v in train.state_dict().items()} == {
+        k: tuple(v.shape) for k, v in serve.state_dict().items()
+    }
+
+
+def test_output_matches_the_training_kernel():
+    """LAYOUTS DIFFER, THE FUNCTION MUST NOT.  The trainer takes
+    [batch, blocks * block_size, hidden]; sglang's draft model is flat [tokens, hidden]
+    and recovers the within-block position as (index % block_size)."""
+    train, serve = _pair()
+    torch.manual_seed(1)
+    tokens = BLOCKS * BLOCK
+    flat = torch.randn(tokens, HIDDEN)
+    with torch.no_grad():
+        expected = train(flat.view(1, tokens, HIDDEN)).view(tokens, HIDDEN)
+        actual = serve(flat)
+    err = (expected - actual).abs().max().item()
+    assert err <= 2e-5, f"max|train - serve| = {err:.3e}"
+
+
+def test_identity_init_is_a_no_op():
+    """An untrained conv must leave the model it was inserted into unchanged, or the
+    arm's null hypothesis is not the arm it is compared against."""
+    serve = DFlashShortConv(HIDDEN, BLOCK, TAPS, GROUP)
+    torch.manual_seed(2)
+    x = torch.randn(BLOCKS * BLOCK, HIDDEN)
+    with torch.no_grad():
+        assert torch.allclose(serve(x), x, atol=1e-6)
+
+
+def test_it_is_block_causal():
+    """Slot t reads t and t-1 WITHIN its block only.  A conv that crossed the block
+    boundary would read a token the draft does not have at serving time, while accept
+    length still looked healthy."""
+    _, serve = _pair()
+    torch.manual_seed(3)
+    x = torch.randn(2 * BLOCK, HIDDEN)
+    with torch.no_grad():
+        base = serve(x)
+        bumped = x.clone()
+        bumped[BLOCK - 1] += 10.0
+        after = serve(bumped)
+    moved = (after - base).abs().amax(dim=-1)
+    assert moved[BLOCK:].max().item() == 0.0, f"block 1 moved: {moved[BLOCK:]}"
+    assert moved[BLOCK - 1].item() > 0.0, "the perturbed slot itself did not move"
+
+
+def test_it_is_not_the_other_wiring():
+    """DFlashShortConv and DFlashGroupedConv have the same kernel and (in the shipped
+    shape) the same parameter count, so 'it runs and the numbers look fine' does not
+    distinguish them.  One side-kernel of the two-sided module, fed the same weights,
+    must NOT reproduce the four-module output -- if it does, the wiring collapsed."""
+    from sglang.srt.models.dflash import DFlashGroupedConv
+
+    _, short = _pair()
+    grouped = DFlashGroupedConv(HIDDEN, BLOCK, TAPS, GROUP)
+    with torch.no_grad():
+        grouped.base_kernel[0].copy_(short.k_base)
+        grouped.base_kernel[1].copy_(short.k_base)
+        grouped.kernel_projection.weight.zero_()
+        grouped.kernel_projection.weight[: short.corr.weight.shape[0]].copy_(
+            short.corr.weight
+        )
+    torch.manual_seed(4)
+    x = torch.randn(BLOCKS * BLOCK, HIDDEN)
+    with torch.no_grad():
+        # The two-sided module applied to its OUTPUT side uses the kernel computed from
+        # the sublayer INPUT; the four-module form recomputes from its own input.  Feed
+        # both the same tensor as "the sublayer output" and they must disagree.
+        _, carried = grouped.prepare(x)
+        other = torch.randn_like(x)
+        assert not torch.allclose(grouped.finish(other, carried), short(other), atol=1e-4)
