+            causal = torch.ones(
+                block, block, device=x.device, dtype=torch.bool
+            ).tril()
+            scores = scores.masked_fill(~causal, float("-inf"))
+        attn = torch.softmax(scores.float(), dim=-1).to(v.dtype)
