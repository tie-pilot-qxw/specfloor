-        k_norm_weight,
-        locs.to(torch.int64).contiguous(),
-        commit_lens_arg,
-        k_cache,
-        v_cache,
-        locs_row_width,
-        KV=num_heads * head_dim,
-        D=head_dim,
-        NH=num_heads,
-        EPS=eps,
-        HAS_COMMIT_LENS=has_commit_lens,
-    )
