-# Added relative to sgl-project/sglang@702de2631 for DSpark prefix-attention drafter serving (specfloor, serving/sglang).
-"""Parity: the AttnHead fused context-KV write vs the eager module path.
-
-Accuracy tests cannot catch a broken context write (spec decoding stays correct
-regardless of draft KV; only accept length drops), so compare the two paths
-directly, and check that rejected rows are left alone rather than written.
-"""
-
-import unittest
-
-import torch
-
-from sglang.srt.models.dspark import AttnHead
-from sglang.test.ci.ci_register import register_cuda_ci
-from sglang.test.test_utils import CustomTestCase
-
-register_cuda_ci(est_time=30, stage="base-b", runner_config="1-gpu-small")
-
-DEVICE = torch.device("cuda")
-HIDDEN = 128
-NUM_HEADS = 2
-HEAD_DIM = 64
-EPS = 1e-6
-SLOTS = 64
-
-
-def _make_head(g):
-    head = AttnHead(
-        vocab_size=64,
-        markov_rank=32,
-        hidden_size=HIDDEN,
-        num_heads=NUM_HEADS,
-        head_dim=HEAD_DIM,
-        mlp_hidden=32,
-        gate_mode="none",
-        rms_norm_eps=EPS,
-        anchor_kv=False,
-    ).to(DEVICE, torch.bfloat16)
-    with torch.no_grad():
-        for t in (head.ctx_norm.weight, head.k_norm.weight):
-            t.copy_(torch.randn(t.shape, device=DEVICE, generator=g).to(t.dtype))
-    head.ensure_context_cache(num_slots=SLOTS, device=DEVICE, dtype=torch.bfloat16)
-    # Builds _ctx_kv_weight and stops at the token-table gate (no embedding source).
-    head.prepare_for_inference()
-    return head
-
-
-def _run(head, *, fused, ctx_hidden, locs, commit_lens, row_width):
-    head._key_cache.zero_()
-    head._value_cache.zero_()
-    saved = head._ctx_kv_weight
-    if not fused:
-        head._ctx_kv_weight = None
-    try:
-        head.write_context_kv(
-            ctx_hidden=ctx_hidden,
-            cache_loc=locs,
-            commit_lens=commit_lens,
-            locs_row_width=row_width,
-        )
-    finally:
-        head._ctx_kv_weight = saved
-    return head._key_cache.clone(), head._value_cache.clone()
-
-
-class TestDsparkCtxKvFusedParity(CustomTestCase):
-    def setUp(self):
-        self.g = torch.Generator(device=DEVICE).manual_seed(0)
-        self.head = _make_head(self.g)
-
-    def _window(self, bs, row_width):
-        n = bs * row_width
-        ctx = torch.randn(
-            n, HIDDEN, device=DEVICE, dtype=torch.float32, generator=self.g
-        ).to(torch.bfloat16)
-        # Distinct live slots, never 0 -- free pages start at 1.
-        locs = torch.randperm(SLOTS - 1, device=DEVICE, generator=self.g)[:n] + 1
-        return ctx, locs.to(torch.int64)
-
-    def test_matches_eager_on_accepted_rows(self):
-        bs, row_width = 3, 5
-        ctx, locs = self._window(bs, row_width)
-        commit_lens = torch.tensor([5, 2, 0], device=DEVICE, dtype=torch.int32)
-
-        k_f, v_f = _run(self.head, fused=True, ctx_hidden=ctx, locs=locs,
-                        commit_lens=commit_lens, row_width=row_width)
-        k_e, v_e = _run(self.head, fused=False, ctx_hidden=ctx, locs=locs,
-                        commit_lens=commit_lens, row_width=row_width)
-
-        col = torch.arange(row_width, device=DEVICE)
-        accepted = (col < commit_lens.view(-1, 1).to(torch.long)).reshape(-1)
-        live = locs[accepted]
-        self.assertEqual(int(live.numel()), 7)
-        # MEASURED bitwise identical on H100 at these shapes; the tolerance is 2 bf16
-        # ulp of slack for a GEMM that tiles differently at another size.
-        for fused, eager in ((k_f, k_e), (v_f, v_e)):
-            torch.testing.assert_close(
-                fused[live].float(), eager[live].float(), rtol=8e-3, atol=8e-3
-            )
-
-    def test_rejected_rows_are_not_written(self):
-        bs, row_width = 3, 5
-        ctx, locs = self._window(bs, row_width)
-        commit_lens = torch.tensor([5, 2, 0], device=DEVICE, dtype=torch.int32)
-        k_f, v_f = _run(self.head, fused=True, ctx_hidden=ctx, locs=locs,
-                        commit_lens=commit_lens, row_width=row_width)
-
-        col = torch.arange(row_width, device=DEVICE)
-        rejected = (col >= commit_lens.view(-1, 1).to(torch.long)).reshape(-1)
-        dead = locs[rejected]
-        self.assertEqual(int(dead.numel()), 8)
-        self.assertTrue(torch.all(k_f[dead] == 0))
-        self.assertTrue(torch.all(v_f[dead] == 0))
-        # Slot 0 is the dummy the eager fallback steers rejects to; the kernel skips
-        # them outright, so it stays clean too.
-        self.assertTrue(torch.all(k_f[0] == 0))
-
-    def test_matches_eager_without_commit_lens(self):
-        ctx, locs = self._window(1, 6)
-        k_f, v_f = _run(self.head, fused=True, ctx_hidden=ctx, locs=locs,
-                        commit_lens=None, row_width=None)
-        k_e, v_e = _run(self.head, fused=False, ctx_hidden=ctx, locs=locs,
-                        commit_lens=None, row_width=None)
-        for fused, eager in ((k_f, k_e), (v_f, v_e)):
-            torch.testing.assert_close(
-                fused[locs].float(), eager[locs].float(), rtol=8e-3, atol=8e-3
-            )
-
-    def test_falls_back_when_cache_is_not_bf16(self):
-        head = _make_head(self.g)
-        ctx = torch.randn(4, HIDDEN, device=DEVICE, dtype=torch.float32)
-        self.assertFalse(head._fused_ctx_kv_supported(ctx))
-        self.assertTrue(
-            head._fused_ctx_kv_supported(ctx.to(torch.bfloat16))
-        )
-
-
-if __name__ == "__main__":
-    unittest.main()
